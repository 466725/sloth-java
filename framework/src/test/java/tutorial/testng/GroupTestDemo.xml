<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="Demo Test Suite">
    <test name="Group Test">
        <!-- For both API and GUI test cases -->
        <parameter name="browser" value="Chrome"></parameter>
        <parameter name="dbConnection" value="Localhost_Sybase"></parameter>
        <parameter name="baseURI" value="https://dev.volantecloud.com"></parameter>
        <!-- For GUI test cases only -->
        <parameter name="URL" value="https://dev.volantecloud.com/aries-ui/"></parameter>
        <parameter name="userName" value="vetest@volantesystems.com"></parameter>
        <parameter name="password" value="test"></parameter>
        <groups>
            <run>
                <include name="test-group"/>
            </run>
        </groups>
        <classes>
            <class name="tutorial.testng.GroupTestDemo"/>
        </classes>
    </test>
</suite>