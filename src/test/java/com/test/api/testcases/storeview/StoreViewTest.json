		{
			"name": "00 Generate Token",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "5ccca273-ccc9-4201-9e6c-4dba04d82949",
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"response must be OK and have a json body\", function () {",
							"     pm.response.to.be.ok;",
							"     pm.response.to.be.withBody;",
							"     pm.response.to.be.json;",
							"});",
							"",
							"pm.test(\"Response time is less than 800ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(800);",
							"});",
							"",
							"var jsonData = pm.response.json();",
							"pm.environment.set(\"my_access_token\", jsonData.access_token);",
							"",
							"console.log('Get Token from jsonData: ', jsonData.access_token);",
							"console.log('Get Token from globals: ', pm.globals.get(\"my_access_token\"));",
							"console.log('Get Token from environment: ', pm.environment.get(\"my_access_token\"));"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"name": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n   \"grant_type\": \"password\",\n   \"email\": \"vetest@volantesystems.com\",\n   \"password\": \"test\"\n}"
				},
