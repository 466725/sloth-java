			"event": [
				{
					"listen": "test",
					"script": {
						"id": "7b353f3c-6208-4d4a-ad7e-50815b90afe9",
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"response must have a json body\", function () {",
							"     pm.response.to.be.withBody;",
							"     pm.response.to.be.json;",
							"});",
							"",
							"pm.test(\"Response time is less than 500ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(500);",
							"});",
							"",
							"var jsonData = pm.response.json();",
							"    ",
							"pm.test(\"Body has siteId\", function () {",
							"    pm.expect(pm.response.text()).to.include(\"siteId\");",
							"});",
							"",
							"pm.test(\"Verify value of siteId\", function () {",
							"    pm.expect(jsonData.siteId).not.to.eql(null);",
							"});",
							"",
							"pm.environment.set('myFirstSiteID', jsonData.siteId);",
							"console.log('Get first Site ID from global: ', pm.environment.get('myFirstSiteID'));",
							"",
							"pm.test(\"Verify value of name\", function () {",
							"    pm.expect(jsonData.name).not.to.eql(null);",
							"});",
							"",
							"pm.environment.set('myFirstSiteName', jsonData.name);",
							"console.log('Get first Site name from global: ', pm.environment.get('myFirstSiteName'));",
							"",
							"pm.test(\"Verify value of city.cityId\", function () {",
							"    pm.expect(jsonData.city.cityId).not.to.eql(null);",
							"});",
							"",
							"pm.test(\"Verify value of address\", function () {",
							"    pm.expect(jsonData.address).not.to.eql(null);",
							"});",
							"",
							"pm.test(\"Verify value of postalCode\", function () {",
							"    pm.expect(jsonData.postalCode).not.to.eql(null);",
							"});",
							"",
							"pm.test(\"Verify value of vertical\", function () {",
							"    pm.expect(jsonData.vertical).not.to.eql(null);",
							"});",
							"",
							"pm.test(\"Verify value of creator.name\", function () {",
							"    pm.expect(jsonData.creator.name).not.to.eql(null);",
							"});",
							"",
							"pm.test(\"Verify value of city.adminDivision.countryCode\", function () {",
							"    pm.expect(jsonData.city.adminDivision.countryCode).not.to.eql(null);",
							"});",
							"",
							"pm.test(\"Verify value of lastModifiedBy.name\", function () {",
							"    pm.expect(jsonData.lastModifiedBy.name).not.to.eql(null);",
							"});"
						],
