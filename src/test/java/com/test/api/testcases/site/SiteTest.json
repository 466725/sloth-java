		{
			"name": "06 Get all Sites",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "900cc38f-cdc6-4458-aaa5-29bd0fb9f74a",
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"response must have a json body\", function () {",
							"     pm.response.to.be.withBody;",
							"     pm.response.to.be.json;",
							"});",
							"",
							"var jsonData = pm.response.json();",
							"var size = jsonData.content.length;",
							"    ",
							"pm.test(\"Body has siteId\", function () {",
							"    pm.expect(pm.response.text()).to.include(\"siteId\");",
							"});",
							"pm.test(\"Verify value of siteId\", function () {",
							"    pm.expect(jsonData.siteId).not.to.eql(null);",
							"});",
							"",
							"pm.test(\"Body has site name\", function () {",
							"    pm.expect(pm.response.text()).to.include(\"name\");",
							"});",
							"pm.test(\"Verify value of site name\", function () {",
							"    pm.expect(jsonData.name).not.to.eql(null);",
							"});",
							"",
							"pm.test(\"Verify Second Site's UUID is in the GetAll call\", function () {",
							"",
							"    var flag = false;",
							"    var uuid = pm.variables.get('mySecondSiteID');",
							"",
							"    for(var i = 0; i < size; i++) ",
							"        {",
							"              if (jsonData.content[i].siteId == uuid) ",
							"                {",
							"                    flag=true;",
							"                }",
							"    }",
							"    pm.expect(flag).to.eql(true);",
							"});",
							"",
							"pm.test(\"Verify that number of elements equals array count\", function () {",
							"    pm.expect(size).to.eql(jsonData.numberOfElements);",
							"    console.log('number of size:', size);",
							"    console.log('number of elements', jsonData.numberOfElements);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
