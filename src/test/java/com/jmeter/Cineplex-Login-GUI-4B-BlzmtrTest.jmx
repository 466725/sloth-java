      <hashTree>
        <com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler guiclass="com.googlecode.jmeter.plugins.webdriver.sampler.gui.WebDriverSamplerGui" testclass="com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler" testname="jp@gc - WebDriver Sampler" enabled="true">
          <stringProp name="WebDriverSampler.script">//Test sample starts here
WDS.sampleResult.sampleStart()

//Declare variables
var pkg = JavaImporter(org.openqa.selenium, org.openqa.selenium.support.ui, org.openqa.selenium.Keys, org.openqa.selenium.support.ui.WebDriverWait)
var wait = new pkg.WebDriverWait(WDS.browser, 1000)
var username = WDS.args[0];
var password = WDS.args[1];
var Thread = {
	sleep: function(ms) {
		var start = Date.now();
		while (true) {
			var clock = (Date.now() - start);
			if (clock &gt;= ms) break;
		}
	}
};

//Navigate to login web page
WDS.log.info(&quot;Attempting to reach the UAT Cineplex page&quot;);
WDS.browser.get(&apos;https://uat-www.cineplex.com/&apos;);

//click the Login button
WDS.log.info(&quot;Click on the LOGIN button&quot;);
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;site-navbar-wrap&apos;]/nav/div[4]/nav/ul/li[2]/a[1]&quot;)).click();

//Switch to Login modal frame
WDS.browser.switchTo().frame(&quot;bootstrapModalIframe&quot;);

//Wait until the Email Address textbox appears
wait.until(pkg.ExpectedConditions.visibilityOfElementLocated(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;txtEmailAddress&apos;]&quot;)))

//Login Flow
//Input email username from csv file
WDS.log.info(&quot;Input the Username&quot;);
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;txtEmailAddress&apos;]&quot;)).sendKeys(&quot;glory.leung@cineplex.com&quot;);

//Input password from csv file
WDS.log.info(&quot;Input the Password&quot;);
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;txtPassword&apos;]&quot;)).sendKeys(&quot;Cineplex@2019&quot;);

//click the Login button
WDS.log.info(&quot;Click on the LOGIN &gt; button&quot;);
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;btnLogin&apos;]&quot;)).click()

//Wait for login process to complete
wait.until(pkg.ExpectedConditions.presenceOfElementLocated(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;search-by-theatre-theatre-selection-area&apos;]&quot;)))

//Start the Test
//Click on Theatre
WDS.log.info(&quot;Click on the theatre dropdown box&quot;);
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//div[contains(@class,&apos;tabs-container visible&apos;)]//div[@id=&apos;search-by-theatre-theatre-selection-area&apos;]&quot;)).click();
Thread.sleep(1000);

//Input Theatre Name
WDS.log.info(&quot;Input the theatre name&quot;);
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//div[contains(@class,&apos;tabs-container visible&apos;)]//div[@id=&apos;search-by-theatre-theatre-selection-area&apos;]/div/selectize-input/div/div[1]/input&quot;)).sendKeys(&apos;H0&apos; + &quot;\n&quot;);
Thread.sleep(1000);

//Click on Movie 
WDS.log.info(&quot;Click on the movie dropdown box&quot;);
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//div[contains(@class,&apos;tabs-container visible&apos;)]//div[@id=&apos;search-by-theatre-movie-selection-area&apos;]&quot;)).click();

//Input Movie Name
WDS.log.info(&quot;Input the movie name&quot;);
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//div[contains(@class,&apos;tabs-container visible&apos;)]//div[@id=&apos;search-by-theatre-movie-selection-area&apos;]/div/selectize-input/div/div[1]/input&quot;)).sendKeys(&apos;Ant-Man And The Wasp&apos; + &quot;\n&quot;);
Thread.sleep(1000);

//Select the Date
WDS.log.info(&quot;Click on the date dropdown box&quot;);
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//div[contains(@class,&apos;tabs-container visible&apos;)]//div[@id=&apos;search-by-theatre-time-selection-area&apos;]&quot;)).click();

//select Date, TODO: Need to improve this since it&apos;s dynamic
WDS.log.info(&quot;Click on a future date&quot;);
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;search-by-theatre-time-selection-area&apos;]/div/selectize-input/div/div[2]/div/div/div[9]&quot;)).click();

//Select the Time
WDS.log.info(&quot;select the first time available&quot;);
wait.until(pkg.ExpectedConditions.presenceOfElementLocated(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;quick-tickets-theatre-showtimes&apos;]/div[1]/div[2]&quot;)));
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;l_7997_s_416850_c_0000000001&apos;]&quot;)).click();


//Wait for the COT ticketing page to load
wait.until(pkg.ExpectedConditions.presenceOfElementLocated(org.openqa.selenium.By.xpath(&quot;/html/body/section/div[1]/div/div/div[2]/section[2]/div/article/div[1]/div&quot;)));

//Add VIP Ticket
WDS.log.info(&quot;Click on Add&quot;);
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;collapse0000000001&apos;]/div/div[2]/section/section/div/div/div[2]/div[1]/button&quot;)).click();
Thread.sleep(500);

//Click Proceed button
WDS.log.info(&quot;Click on Proceed&quot;);
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//button[contains(@data-bind,&apos;Proceed&apos;)]&quot;)).click();

//Click Proceed again
WDS.log.info(&quot;Click on Proceed&quot;);
wait.until(pkg.ExpectedConditions.presenceOfElementLocated(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;seatmap&apos;]/h3&quot;)));
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//button[contains(@data-bind,&apos;Proceed&apos;)]&quot;)).click();

//Click Proceed button
WDS.log.info(&quot;Click on Proceed&quot;);
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//button[contains(@data-bind,&apos;Proceed&apos;)]&quot;)).click();

Thread.sleep(60000);

//Click Cineplex Logo
//WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;/html/body/section/div/header/div[2]/div/div[1]/a/img&quot;)).click();

//Logout
//WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;ccoptions&apos;]/div/ul/li[2]/a&quot;)).click();
//wait.until(pkg.ExpectedConditions.presenceOfElementLocated(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;site-navbar-wrap&apos;]/nav/div[2]/ul/li[2]&quot;)))
//Wait 20 minutes


//Test sample ends here
WDS.sampleResult.sampleEnd()
</stringProp>
