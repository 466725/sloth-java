        <com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler guiclass="com.googlecode.jmeter.plugins.webdriver.sampler.gui.WebDriverSamplerGui" testclass="com.googlecode.jmeter.plugins.webdriver.sampler.WebDriverSampler" testname="jp@gc - WebDriver Sampler" enabled="true">
          <stringProp name="WebDriverSampler.script">//Test sample starts here
WDS.sampleResult.sampleStart()

//Declare variables
var pkg = JavaImporter(org.openqa.selenium, org.openqa.selenium.support.ui, org.openqa.selenium.Keys)
var wait = new pkg.WebDriverWait(WDS.browser, 1000)
var username = WDS.args[0];
var password = WDS.args[1];
var Thread = {
	sleep: function(ms) {
		var start = Date.now();
		while (true) {
			var clock = (Date.now() - start);
			if (clock &gt;= ms) break;
		}
	}
};

//Navigate to login web page
WDS.browser.get(&apos;https://uat-www.cineplex.com/&apos;)

//Click Showtimes
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;site-navbar-wrap&apos;]/nav/div[2]/ul/li[1]/a&quot;)).click();
Thread.sleep(1000);

//Click on the Select Dates
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;showtimesDate&apos;]&quot;)).click();
Thread.sleep(500);

//Select a future Date from the dropdown
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;showtimesDate&apos;]/option[13]&quot;)).click();
Thread.sleep(500);

//Click on &quot;Refresh Results&quot;
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;ShowtimesWidget&apos;]/div[2]/button&quot;)).click();
Thread.sleep(1000);

//Wait for Results to appear
wait.until(pkg.ExpectedConditions.elementToBeClickable(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;showtimes-partial-update&apos;]/div[2]/div[1]/div/div[2]/div[2]/div[2]/a/span[3]&quot;)))
Thread.sleep(10000);

//Click on the blue ribbon to expand the show times
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;showtimes-partial-update&apos;]/div[2]/div[1]/div/div[2]/div[2]/div[2]/a/span[3]&quot;)).click();

//Wait for the show times to appear
wait.until(pkg.ExpectedConditions.elementToBeClickable(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;l_7997_s_417298_c_0000000001&apos;]&quot;)))
Thread.sleep(5000);

//Click on the first available showtime
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;l_7997_s_417298_c_0000000001&apos;]&quot;)).click();
Thread.sleep(4000);

//Login from login modal
WDS.browser.switchTo().frame(&quot;bootstrapModalIframe&quot;);
wait.until(pkg.ExpectedConditions.visibilityOfElementLocated(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;txtEmailAddress&apos;]&quot;)))
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;txtEmailAddress&apos;]&quot;)).sendKeys(username);
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;txtPassword&apos;]&quot;)).sendKeys(password);
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;btnLogin&apos;]&quot;)).click()
WDS.browser.switchTo().defaultContent();

//Workaround for bug in UAT
WDS.browser.executeScript(&quot;location.reload()&quot;);
Thread.sleep(5000);

//Select the Move and Time again due to Login bug in UAT.  Will remove this block of code when the bug is fixed
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;showtimes-partial-update&apos;]/div[2]/div[1]/div/div[2]/div[2]/div[2]/a/span[3]&quot;)).click();
wait.until(pkg.ExpectedConditions.elementToBeClickable(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;l_7997_s_417298_c_0000000001&apos;]&quot;)))
Thread.sleep(5000);
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;l_7997_s_417298_c_0000000001&apos;]&quot;)).click();

Thread.sleep(5000);
//Click Add Button
wait.until(pkg.ExpectedConditions.presenceOfElementLocated(org.openqa.selenium.By.xpath(&quot;/html/body/section/div[1]/div/div/div[2]/section[2]/div/article/div[1]/div&quot;)));

//Add VIP Ticket
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;collapse0000000001&apos;]/div/div[2]/section/section/div/div/div[2]/div[1]/button&quot;)).click();

//Click Proceed button
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;proceedBar&apos;]/div/div/div[3]/div/div/div[4]/button&quot;)).click();

//Click Proceed again
wait.until(pkg.ExpectedConditions.presenceOfElementLocated(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;seatmap&apos;]/h3&quot;)));
WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;proceedBar&apos;]/div/div/div[3]/div/div/div[5]/button&quot;)).click();

//Wait for Timeout
Thread.sleep(2000);

//Click Cineplex Logo
//WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;/html/body/section/div/header/div[2]/div/div[1]/a/img&quot;)).click();
//Logout
//WDS.browser.findElement(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;ccoptions&apos;]/div/ul/li[2]/a&quot;)).click();
//wait.until(pkg.ExpectedConditions.presenceOfElementLocated(org.openqa.selenium.By.xpath(&quot;//*[@id=&apos;site-navbar-wrap&apos;]/nav/div[2]/ul/li[2]&quot;)))

//Test sample ends here
WDS.sampleResult.sampleEnd()
</stringProp>
