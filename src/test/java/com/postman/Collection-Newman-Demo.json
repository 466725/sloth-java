	"item": [
		{
			"name": "Handle Environment Difference",
			"item": [
				{
					"name": "Handle Environment Difference",
					"event": [
						{
							"listen": "test",
							"script": {
								"id": "b23fadc6-9750-42f9-abee-78294711f9cb",
								"exec": [
									"if (pm.environment.get(\"cineplex_url\").has(\"stage\")) {",
									"    console.log(\"We are runing on Staging environment!\");",
									"    tests[\"Status code is 404\"] = responseCode.code === 404;",
									"    tests[\"Response time is acceptable\"] = responseTime < pm.variables.get(\"max_response_time\"); // milliseconds",
									"} else {",
									"    console.log(\"We are not runing on Staging environment!\");",
									"    tests[\"Status code is 200\"] = responseCode.code === 200;",
									"    tests[\"Response time is acceptable\"] = responseTime < pm.variables.get(\"max_response_time\"); // milliseconds",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Ocp-Apim-Subscription-Key",
								"value": "{{subscriptionKey}}"
							}
						],
						"url": {
							"raw": "{{cineplex_url}}/store/promo/health/status",
							"host": [
								"{{cineplex_url}}"
							],
							"path": [
								"store",
								"promo",
								"health",
								"status"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Code Reuse",
			"item": [
				{
					"name": "Code Reuse",
					"event": [
						{
							"listen": "test",
							"script": {
								"id": "742c3d42-39ee-4780-9ba4-4930f96a9d66",
								"exec": [
									"postman.setGlobalVariable(\"commonTests\", () => {\r",
									"    var jsonBody = pm.response.json();\r",
									"    tests[\"Status is defined\"] = jsonBody.Status !== undefined;\r",
									"    tests[\"Status has a correct value\"] = jsonBody.Status === 1;\r",
									"    tests[\"Response time is acceptable\"] = responseTime < 50000;\r",
									"});\r",
									"\r",
									"eval(globals.commonTests)();\r",
									"tests[\"Status code is 200\"] = responseCode.code === 200;"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"Device\":\"samsung-tizen\",\n\t\"Language\":1\n}"
						},
						"url": {
							"raw": "{{store_url}}/CSWebConnectV2/GetAppHomePage",
							"host": [
								"{{store_url}}"
							],
							"path": [
								"CSWebConnectV2",
								"GetAppHomePage"
							]
						},
						"description": "A demo of test code reuse."
					},
					"response": []
				},
				{
					"name": "Code Reuse+",
					"event": [
						{
							"listen": "test",
							"script": {
								"id": "742c3d42-39ee-4780-9ba4-4930f96a9d66",
								"exec": [
									"eval(globals.commonTests)();\r",
									"tests[\"Status code is 200\"] = responseCode.code === 200;"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
