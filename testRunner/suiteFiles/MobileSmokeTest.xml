<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Mobile Smoke Test Suite" verbose="1" preserve-order="true">
    <listeners>
        <listener class-name="testcases.FailureListener"/>
    </listeners>

    <test name="MobileSmoke" parallel="false">
        <!-- Local only: this suite requires Appium + Android emulator/device and is not run on GitHub hosted CI. -->
        <classes>
            <class name="testcases.mobile.web.TestAmazonMobileSigninPage"/>
            <class name="testcases.mobile.app.TestAndroidDeviceConnectivity"/>
        </classes>
    </test>
</suite>
