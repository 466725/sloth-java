<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="Amazon Sanity Test Suite">
    <listeners>
        <listener class-name="testcases.FailureListener"/>
    </listeners>

    <test name="Sanity Test" parallel="false">
        <classes>
            <!-- GUI test cases -->
            <class name="testcases.amazon.HomePageTest"/>
            <class name="testcases.amazon.SigninPageTest"/>
            <class name="testcases.amazon.RegisterPageTest"/>
            <!-- API test cases -->
            <class name="testcases.cineplex.SigninWrongCredentials"/>
        </classes>
    </test>
</suite>
