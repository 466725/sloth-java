<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Regression Test Suite" verbose="1" preserve-order="true">
    <listeners>
        <listener class-name="testcases.FailureListener"/>
    </listeners>

    <test name="Regression" parallel="false">
        <groups>
            <run>
                <include name="regression"/>
                <exclude name="quarantine"/>
            </run>
        </groups>

        <!-- Scan packages so any new @Test(groups={"regression", ...}) is auto-included -->
        <packages>
            <package name="testcases.*"/>
            <package name="scenarios.*"/>
        </packages>
    </test>
</suite>
