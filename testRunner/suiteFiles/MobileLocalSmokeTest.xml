<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Mobile App and Web Local Smoke Test Suite" verbose="1" preserve-order="true">
    <listeners>
        <listener class-name="testcases.FailureListener"/>
    </listeners>

    <!-- Here we can add any test class, docker environment ready for all -->
    <test name="MobileAppAndWebLocalSmoke" parallel="false">
        <classes>
            <!-- Web test cases -->
            <class name="testcases.mobile.web.TestAmazonMobileSigninPage"/>
            <!-- App test cases -->
            <!-- App test works only locally currently -->
            <class name="testcases.mobile.app.TestAndroidDeskClockLaunch"/>
            <class name="testcases.mobile.app.TestAndroidDeskClockSetAlarm"/>
        </classes>
    </test>
</suite>
